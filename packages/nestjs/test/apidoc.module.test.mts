import 'reflect-metadata'
import { Controller, Get, Module, type INestApplication } from '@nestjs/common'
import { NestFactory } from '@nestjs/core'
import { FastifyAdapter } from '@nestjs/platform-fastify'
import { ApiOkResponse, DocumentBuilder, SwaggerModule } from '@nestjs/swagger'
import { afterEach, describe, expect, it } from 'vitest'
import { ApidocModule, type ApidocModuleOptions } from '../src/index.js'

@Controller('customers')
class CustomersController {
  @Get()
  @ApiOkResponse({ description: 'All customers' })
  list() {
    return [{ id: 1 }]
  }
}

@Module({ controllers: [CustomersController] })
class AppModule {}

const apps: INestApplication[] = []
afterEach(async () => {
  await Promise.all(apps.splice(0).map(app => app.close()))
})

type Setup = (app: INestApplication) => void

async function start(adapter: 'express' | 'fastify', setup: Setup, prefix?: string) {
  const app = adapter === 'fastify' ? await NestFactory.create(AppModule, new FastifyAdapter(), { logger: false }) : await NestFactory.create(AppModule, { logger: false })
  apps.push(app)
  if (prefix) app.setGlobalPrefix(prefix)
  setup(app)
  await app.listen(0, '127.0.0.1')
  const base = await app.getUrl()
  return (path: string, init?: RequestInit) => fetch(base + path, { redirect: 'manual', ...init })
}

function swaggerDocument(app: INestApplication) {
  return SwaggerModule.createDocument(app, new DocumentBuilder().setTitle('Orbit').setVersion('2.4.0').build())
}

function withDocs(options?: ApidocModuleOptions, path = 'docs'): Setup {
  return app => ApidocModule.setup(path, app, swaggerDocument(app), options)
}

describe.each(['express', 'fastify'] as const)('%s adapter', adapter => {
  it('serves the docs page titled from the Swagger document', async () => {
    const get = await start(adapter, withDocs())
    const response = await get('/docs/')
    expect(response.status).toBe(200)
    expect(response.headers.get('content-type')).toBe('text/html; charset=utf-8')
    const html = await response.text()
    expect(html).toContain('<title>Orbit</title>')
    expect(html).toContain('<api-docs spec-url="openapi.json"></api-docs>')
  })

  it('serves the document generated by @nestjs/swagger', async () => {
    const get = await start(adapter, withDocs())
    const response = await get('/docs/openapi.json')
    expect(response.headers.get('content-type')).toBe('application/json; charset=utf-8')
    const document = (await response.json()) as { info: { version: string }; paths: Record<string, unknown> }
    expect(document.info.version).toBe('2.4.0')
    expect(Object.keys(document.paths)).toEqual(['/customers'])
  })

  it('redirects /docs to docs/', async () => {
    const get = await start(adapter, withDocs())
    const response = await get('/docs?x=1')
    expect(response.status).toBe(302)
    expect(response.headers.get('location')).toBe('docs/?x=1')
  })

  it('serves the bundle and its chunks', async () => {
    const get = await start(adapter, withDocs())
    const entry = await get('/docs/_static/apidoc.js')
    expect(entry.status).toBe(200)
    expect(entry.headers.get('content-type')).toBe('text/javascript; charset=utf-8')
    const chunk = (await entry.text()).match(/chunks\/[\w.-]+\.js/)?.[0]
    const response = await get(`/docs/_static/${chunk}`)
    expect(response.status).toBe(200)
    expect(response.headers.get('cache-control')).toContain('immutable')
    const cached = await get(`/docs/_static/${chunk}`, { headers: { 'if-none-match': response.headers.get('etag')! } })
    expect(cached.status).toBe(304)
  })

  it('404s for unknown files and leaves the app routes alone', async () => {
    const get = await start(adapter, withDocs())
    expect((await get('/docs/_static/chunks/nope.js')).status).toBe(404)
    expect((await get('/docs/openapi.yaml')).status).toBe(404)
    expect(await (await get('/customers')).json()).toEqual([{ id: 1 }])
  })

  it('honours the global prefix when asked', async () => {
    const get = await start(adapter, withDocs({ useGlobalPrefix: true }), 'api')
    expect((await get('/api/docs/')).status).toBe(200)
    expect((await get('/api/docs/openapi.json')).status).toBe(200)
    expect((await get('/docs/')).status).toBe(404)
  })

  it('ignores the global prefix by default, like SwaggerModule', async () => {
    const get = await start(adapter, withDocs(), 'api')
    expect((await get('/docs/')).status).toBe(200)
    expect((await get('/api/customers')).status).toBe(200)
  })

  it('points at an external spec with document = null', async () => {
    const get = await start(adapter, app => ApidocModule.setup('reference', app, null, { specUrl: '/api-json', title: 'Ext', theme: 'light' }))
    const html = await (await get('/reference/')).text()
    expect(html).toContain('<api-docs spec-url="/api-json" theme="light"></api-docs>')
    expect((await get('/reference/openapi.json')).status).toBe(404)
  })

  it('passes branding through to the page', async () => {
    const get = await start(adapter, withDocs({ accent: '#14b8a6', logo: '/logo.svg', faviconUrl: '/favicon.ico' }))
    const html = await (await get('/docs/')).text()
    expect(html).toContain('accent="#14b8a6" logo="/logo.svg"')
    expect(html).toContain('<link rel="icon" href="/favicon.ico">')
  })

  it('calls a document factory once', async () => {
    let calls = 0
    const get = await start(adapter, app =>
      ApidocModule.setup('docs', app, () => {
        calls++
        return swaggerDocument(app)
      }),
    )
    expect(calls).toBe(0)
    await get('/docs/')
    await get('/docs/openapi.json')
    expect(calls).toBe(1)
  })
})

describe('ApidocModule.setup', () => {
  it('refuses the root path', async () => {
    const app = await NestFactory.create(AppModule, { logger: false })
    apps.push(app)
    expect(() => ApidocModule.setup('/', app, null, { specUrl: '/x' })).toThrow(/root/)
  })
})
